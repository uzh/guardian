{0 Guardian}

Generic framework for roles and permissions to be used in our projects

{1 Packages}

- [guardian]: roles, permissions and validation ({!Guardian}), plus the backend ({!Guardian_backend.Make}) running
  on veins connection pools, on MariaDB / MySQL and PostgreSQL 15+. Its SQL follows the dialect of each
  connection, so there is one package for both; for the driver, use veins' library [veins.mariadb] or
  [veins.postgresql] and depend on its Caqti driver ([caqti-driver-mariadb], [caqti-driver-postgresql]).

{1 Setup}

Guardian runs its statements on your veins pool and on the context you pass as [?ctx]: a label, a held connection
or an open transaction, so guardian writes commit or roll back with yours.

{[
  module Db = Veins_mariadb.Pools.Make (struct
    let database =
      Veins.Database.create (Veins.Label.create "app")
        (Veins.Url.create "mariadb://root@database:3306/dev")
  end)

  module Guard =
    Guardian_backend.Make (Roles.Actor) (Roles.Role) (Roles.Target)
      (Guardian_backend.Database.Make
         (Guardian_backend.Database.Of_veins (Db) (struct let default_role = Veins.Role.owner end)))

  let () = Db.Pool.initialize ()
  let%lwt () = Guard.migrate ~ctx:(Db.label_ctx ~role:Veins.Role.owner (Veins.Label.create "app")) ()
]}

Every statement declares what it needs ({!Guardian_backend.Needs}: [`Read], [`Write], [`Schema]), and guardian's
functions state it in their types, so a context whose veins role lacks a right doesn't compile. Without [?ctx],
guardian runs as the [default_role] given to [Database.Of_veins], which must grant everything (e.g.
[Veins.Role.owner]). With {!Guardian_backend.Database.Of_veins_explicit} there is no default: a call without [?ctx]
raises the exception you give it, for applications that pass [?ctx] to every call (e.g. one database per tenant).

{1 Usage}

The [test] directory shows an example implementation of how guardian can be used.

- {b [role.ml]} : Definition of actors and targets
- {b [role.mli]} : Signature of the defined actors and targets
- {b [guard.ml]} : Create the guardian service
- {b [article.ml]} : Definition of the article target
- {b [hacker.ml]} : Definition of the hacker actor
- {b [user.ml]} : Definition of the user actor and target
- {b [main.ml]} : implementation of all test cases

Example usage:

{[
  module Guard = Guardian.Make (Role.Actor) (Role.Target)

  let thomas = "Thomas", Guard.Uuid.Actor.create ()
  let mike = "Mike", Guard.Uuid.Actor.create ()

  let thomas_article = Article.make "Foo" "Bar" thomas
  let mike_article = Article.make "Hello" "World" mike

  let example_rule = `Actor (snd mike), `Update, `Target thomas_article.uuid

  let initialize_authorizables_and_rules ?ctx =
    (* Note: As a user can be an actor and a target, both need to be initialized *)
    let* (_: [> `User ] MariaDb.actor) = User.to_authorizable ?ctx thomas in
    let* (_: [> `User ] MariaDb.actor) = User.to_authorizable ?ctx mike in
    let* (_: [> `User ] MariaDb.target) = UserTarget.to_authorizable ?ctx thomas in
    let* (_: [> `User ] MariaDb.target) = UserTarget.to_authorizable ?ctx mike in
    let* (_: [> `Article ] MariaDb.target) = Article.to_authorizable ?ctx thomas_article in
    let* (_: [> `Article ] MariaDb.target) = Article.to_authorizable ?ctx mike_article in
    let* () = MariaDb.Rule.save ?ctx example_role in
    Lwt.return_unit

  (* let mike Update the title of thomas article -> returns a (Article.t, string) Lwt_result.t  *)
  let update_title = Article.update_title ?ctx mike thomas_article "Updated Title"
]}

{1:api API}

{!modules:
Guardian
Guardian_backend
}
