# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.6.0"
synopsis: "PostgreSQL backend for guardian"
description:
  "Guardian's persistence on PostgreSQL, running on veins connection pools."
maintainer: ["engineering@econ.uzh.ch"]
authors: [
  "Department of Economics, University of Zurich" "John Christopher McAlpine"
]
license: "GPL-2.0-or-later"
homepage: "https://github.com/uzh/guardian"
doc: "https://uzh.github.io/guardian"
bug-reports: "https://github.com/uzh/guardian/issues"
depends: [
  "dune" {>= "2.9"}
  "guardian" {= version}
  "caqti-driver-postgresql" {>= "3.0.0"}
  "veins-postgresql" {>= "0.2.0"}
  "ppx_string"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
dev-repo: "git+https://github.com/uzh/guardian.git"
# veins isn't on opam yet; move to a release tag once uzh/veins 0.2.0 is tagged
pin-depends: [
  ["veins.0.2.0" "git+https://github.com/uzh/veins.git#main"]
  ["veins-mariadb.0.2.0" "git+https://github.com/uzh/veins.git#main"]
  ["veins-postgresql.0.2.0" "git+https://github.com/uzh/veins.git#main"]
]
